#!/usr/bin/env bash
# Demo: review dashboard on the LAN + Tailscale network.
cd "$(dirname "$0")"
TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
echo "── Bellhaven review app ── nothing writes to the CRM without an approval here."
echo "   /         proposal queue + decision log (reads the local SQLite store)"
echo "   /results  every website location and its outcome"
echo "   /endstate live reconciliation report (queries the CRM, read-only)"
echo
echo "   local:     http://localhost:8741"
[ -n "$TS_IP" ] && echo "   tailscale: http://$TS_IP:8741"
echo
exec python3 -m uvicorn bellhaven.app:app --host 0.0.0.0 --port 8741
